# Use venv
python -m venv venv
# Active venv
# git bash
source venv/Scripts/activate

##### install packages requirement
pip install transformers torch huggingface_hub accelerate

# Login Hugging face 
huggingface-cli login .   and paste your hugging face token/ Need to be verify from hugging face and Meta 

##### How to download model via terminal

python -c "
from huggingface_hub import snapshot_download
snapshot_download(
    repo_id='meta-llama/Llama-3.2-1B-Instruct',
    local_dir='./model',
    local_dir_use_symlinks=False
)
"

##### 3b model 
python -c "
from huggingface_hub import snapshot_download
snapshot_download(
    repo_id='meta-llama/Llama-3.2-3B-Instruct',
    local_dir='./model/llama-3b',
    ignore_patterns=['original/*']
)
"

